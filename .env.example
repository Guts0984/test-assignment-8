# Copy to .env:  cp .env.example .env
# Every variable of the project lives here. Values below are DEV-ONLY placeholders;
# change the secrets for anything that is not a local run.
# apps/api/src/env.ts validates these with Zod (non-secret ones have defaults there, secrets do not).

# ---- general ----
NODE_ENV=development
TZ=UTC

# ---- postgres (secret: POSTGRES_PASSWORD) ----
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_password
POSTGRES_DB=helpdesk
# Port published on 127.0.0.1 for local tooling and tests (inside compose the app uses postgres:5432).
POSTGRES_PORT=5440

# Connection string used from the host (migrations, seed, `npm run dev`).
DATABASE_URL=postgres://helpdesk:helpdesk_dev_password@localhost:5440/helpdesk
# Test suites create and drop throw-away databases; this role must be allowed to CREATE DATABASE.
TEST_ADMIN_DATABASE_URL=postgres://helpdesk:helpdesk_dev_password@localhost:5440/postgres

# ---- seed (optional; the assignment demo uses 20000 tickets / 200 customers) ----
# Lower SEED_TICKETS for a fast e2e/dev database. Ignored once the database already has data.
SEED_TICKETS=20000
SEED_CUSTOMERS=200
