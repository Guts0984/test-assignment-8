# Copy to .env:  cp .env.example .env
# Every variable of the project lives here. Values below are DEV-ONLY placeholders;
# change the secrets for anything that is not a local run.
# apps/api/src/env.ts validates these with Zod (non-secret ones have defaults there, secrets do not).

# ---- general ----
NODE_ENV=development
TZ=UTC

# ---- postgres (secret: POSTGRES_PASSWORD) ----
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_password
POSTGRES_DB=helpdesk
# Port published on 127.0.0.1 for local tooling and tests (inside compose the app uses postgres:5432).
POSTGRES_PORT=5440

# Connection string used from the host (migrations, seed, `npm run dev`).
DATABASE_URL=postgres://helpdesk:helpdesk_dev_password@localhost:5440/helpdesk
# Test suites create and drop throw-away databases; this role must be allowed to CREATE DATABASE.
TEST_ADMIN_DATABASE_URL=postgres://helpdesk:helpdesk_dev_password@localhost:5440/postgres

# ---- seed (optional; the assignment demo uses 20000 tickets / 200 customers) ----
# Lower SEED_TICKETS for a fast e2e/dev database. Ignored once the database already has data.
SEED_TICKETS=20000
SEED_CUSTOMERS=200

# ---- api (apps/api/src/env.ts validates these; only DATABASE_URL above is secret) ----
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Apply migrations / seed demo data when the api boots (docker-compose relies on both).
AUTO_MIGRATE=true
AUTO_SEED=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000

SESSION_TTL_HOURS=168
SESSION_MAX_PER_USER=10
COOKIE_NAME=hd_session
# Defaults to true when NODE_ENV=production. Leave unset for local http.
# COOKIE_SECURE=true

# Proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs). Empty = header never trusted.
TRUSTED_PROXIES=
# Origins allowed for CORS and for state-changing requests (CSRF). The web app's origin.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=600
LOGIN_WINDOW_SECONDS=900
LOGIN_IP_MAX_FAILURES=20
LOGIN_PAIR_MAX_FAILURES=5
LOGIN_MAX_CONCURRENCY=4
LOGIN_QUEUE_MAX=16

BODY_LIMIT_BYTES=262144
MAX_CONNECTIONS=2000
HEADERS_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
