{
  "name": "helpdesk",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @helpdesk/shared build && pnpm --filter @helpdesk/db build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node scripts/test-summary.mjs",
    "test:verbose": "pnpm build && pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @helpdesk/db db:migrate",
    "db:seed": "pnpm --filter @helpdesk/db db:seed",
    "db:reset": "pnpm --filter @helpdesk/db db:reset",
    "db:check-drift": "pnpm --filter @helpdesk/db generate && git diff --exit-code -- packages/db/drizzle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "3.6.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.6.0"
}
