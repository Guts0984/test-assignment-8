{
  "name": "@helpdesk/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "helpdesk-db": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts src/cli.ts --format cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed",
    "db:reset": "tsx src/cli.ts reset"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "@helpdesk/shared": "workspace:*"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
